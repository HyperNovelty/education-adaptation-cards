{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hypernovelty/ipublishos/education_adaptation_cards.schema.json",
  "title": "iPublishOS / Agent OS Education Adaptation Cards",
  "description": "Local-only implementation-facing contract for attaching teacher, student, and assessment/gate education adaptation cards to iPublishOS or Agent OS review packets. Documentation-first; validated locally by tests/validate_education_adaptation_cards.py with only the Python standard library.",
  "type": "object",
  "required": ["generated_at", "safety_mode", "target_system", "review_packet", "education_adaptation_cards"],
  "additionalProperties": false,
  "properties": {
    "generated_at": {"type": "string", "description": "UTC ISO-8601 timestamp for the local mock packet."},
    "safety_mode": {"const": "local_review_only", "description": "Hard boundary: this artifact is local review material only, not publication, classroom deployment, or student-facing release."},
    "target_system": {"enum": ["ipublishos", "agent_os", "ipublishos_agent_os_bridge"]},
    "review_packet": {"$ref": "#/$defs/review_packet_ref"},
    "learning_dossier": {"$ref": "#/$defs/learning_dossier"},
    "education_adaptation_cards": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/education_card"},
      "description": "Cards to render inside or alongside a review packet. Implementations should include exactly one teacher_card, one student_card, and one assessment_gate_card for a complete education lane."
    }
  },
  "$defs": {
    "review_packet_ref": {
      "type": "object",
      "required": ["packet_id", "packet_title", "packet_path", "packet_status"],
      "additionalProperties": false,
      "properties": {
        "packet_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "packet_title": {"type": "string", "minLength": 1},
        "packet_path": {"type": "string", "description": "Absolute or repo-relative local packet path that must resolve inside this repository checkout for this prototype."},
        "packet_status": {
          "enum": ["draft_only", "needs_human_review", "approved_for_internal_review", "rejected"],
          "description": "Compatible packet status enum. The local custom validator intentionally gates runnable fixtures to draft_only or needs_human_review until separate approval."
        }
      }
    },
    "education_card": {
      "type": "object",
      "required": ["card_id", "card_type", "title", "audience", "purpose", "source_binding", "adaptation_actions", "risks", "human_review", "outputs"],
      "additionalProperties": false,
      "properties": {
        "card_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "card_type": {"enum": ["teacher_card", "student_card", "assessment_gate_card"]},
        "title": {"type": "string", "minLength": 1},
        "audience": {"enum": ["teacher", "student", "reviewer", "curriculum_reviewer"]},
        "grade_band": {"enum": ["adult_professional", "higher_ed", "high_school", "middle_school", "elementary", "mixed", "unspecified"]},
        "purpose": {"type": "string", "minLength": 1},
        "source_binding": {"$ref": "#/$defs/source_binding"},
        "adaptation_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
        "human_review": {"$ref": "#/$defs/human_review"},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output_ref"}},
        "learner_questions": {"type": "array", "items": {"$ref": "#/$defs/learner_question"}, "description": "Optional local-only learner questions. When present, each question's source_ids must be unique, must reference this card's source_binding.allowed_source_ids, must be non-empty for source_bound or partially_sourced, and must be empty for unanswered or out_of_scope."},
        "misconception_evidence": {"type": "array", "items": {"$ref": "#/$defs/misconception_evidence"}, "description": "Optional local-only evidence records for likely misconception signals and teacher/reviewer response. When present, each evidence record requires one or more unique source_ids declared in this card's source_binding.allowed_source_ids."},
        "assessment_gates": {"type": "array", "items": {"$ref": "#/$defs/assessment_gate"}, "description": "Required when card_type is assessment_gate_card."}
      }
    },
    "source_binding": {
      "type": "object",
      "required": ["source_policy", "allowed_source_ids", "blocked_claims_policy"],
      "additionalProperties": false,
      "properties": {
        "source_policy": {"enum": ["packet_sources_only", "approved_references_only", "no_new_claims"]},
        "allowed_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Card-local source IDs that learner questions and misconception evidence may cite. Duplicate IDs are rejected by the local validator."},
        "blocked_claims_policy": {"type": "string", "minLength": 1}
      }
    },
    "risk": {
      "type": "object",
      "required": ["risk_id", "risk_level", "risk_text", "mitigation"],
      "additionalProperties": false,
      "properties": {
        "risk_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "risk_level": {"enum": ["low", "medium", "high", "unknown"]},
        "risk_text": {"type": "string", "minLength": 1},
        "mitigation": {"type": "string", "minLength": 1}
      }
    },
    "human_review": {
      "type": "object",
      "required": ["status", "required_roles", "review_notes"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["draft_only", "needs_human_review", "approved_for_internal_review", "rejected"],
          "description": "Compatible human review status enum. The local custom validator intentionally gates runnable fixtures to draft_only or needs_human_review until separate approval."
        },
        "required_roles": {"type": "array", "minItems": 1, "items": {"enum": ["author", "editor", "teacher", "curriculum_reviewer", "legal_or_policy"]}},
        "review_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "output_ref": {
      "type": "object",
      "required": ["output_id", "output_type", "description"],
      "additionalProperties": false,
      "properties": {
        "output_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "output_type": {"enum": ["lesson_plan", "discussion_prompt", "student_activity", "rubric", "gate_report", "review_note"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "learner_question": {
      "type": "object",
      "required": ["question_id", "question_text", "question_status", "source_ids", "reviewer_note"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "question_status": {"enum": ["source_bound", "partially_sourced"]}
            },
            "required": ["question_status"]
          },
          "then": {
            "properties": {
              "source_ids": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_status": {"enum": ["unanswered", "out_of_scope"]}
            },
            "required": ["question_status"]
          },
          "then": {
            "properties": {
              "source_ids": {"maxItems": 0}
            }
          }
        }
      ],
      "properties": {
        "question_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "question_text": {"type": "string", "minLength": 1},
        "question_status": {"enum": ["unanswered", "partially_sourced", "source_bound", "out_of_scope"]},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Unique card-local source IDs. Must be non-empty for source_bound or partially_sourced questions and empty for unanswered or out_of_scope questions."},
        "reviewer_note": {"type": "string", "minLength": 1}
      }
    },
    "misconception_evidence": {
      "type": "object",
      "required": ["misconception_id", "misconception_text", "evidence_signal", "source_ids", "severity", "teacher_response", "reviewer_note"],
      "additionalProperties": false,
      "properties": {
        "misconception_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "misconception_text": {"type": "string", "minLength": 1},
        "evidence_signal": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "One or more unique card-local source IDs declared in source_binding.allowed_source_ids."},
        "severity": {"enum": ["low", "medium", "high", "unknown"]},
        "teacher_response": {"type": "string", "minLength": 1},
        "reviewer_note": {"type": "string", "minLength": 1}
      }
    },
    "assessment_gate": {
      "type": "object",
      "required": ["gate_id", "gate_name", "gate_status", "evidence_required"],
      "additionalProperties": false,
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "gate_name": {"type": "string", "minLength": 1},
        "gate_status": {"enum": ["pass", "fail", "needs_review", "not_run"]},
        "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "learning_dossier": {
      "type": "object",
      "required": ["dossier_id", "dossier_title", "folder_layout", "learning_mission", "source_reference_sheet", "question_map", "practice_task", "evidence_checklist", "review_gate"],
      "additionalProperties": false,
      "properties": {
        "dossier_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "dossier_title": {"type": "string", "minLength": 1},
        "folder_layout": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "learning_mission": {"$ref": "#/$defs/learning_mission"},
        "source_reference_sheet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dossier_source"}},
        "question_map": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dossier_question"}},
        "practice_task": {"$ref": "#/$defs/practice_task"},
        "evidence_checklist": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_checklist_item"}},
        "review_gate": {"$ref": "#/$defs/dossier_review_gate"}
      }
    },
    "learning_mission": {
      "type": "object",
      "required": ["mission_id", "audience", "objective", "review_state"],
      "additionalProperties": false,
      "properties": {
        "mission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "audience": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "review_state": {"enum": ["draft_only", "needs_human_review"]}
      }
    },
    "dossier_source": {
      "type": "object",
      "required": ["source_id", "title", "creator", "publication_year", "public_domain_status", "public_domain_basis", "url", "excerpt"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "public_domain_status": {"const": "pre_1929_public_domain_us"}
            },
            "required": ["public_domain_status"]
          },
          "then": {
            "properties": {
              "publication_year": {"maximum": 1928}
            }
          }
        }
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "publication_year": {"type": "integer"},
        "public_domain_status": {"enum": ["pre_1929_public_domain_us", "us_federal_government_work"]},
        "public_domain_basis": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "dossier_question": {
      "type": "object",
      "required": ["question_id", "question", "source_ids", "reviewer_note"],
      "additionalProperties": false,
      "properties": {
        "question_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "question": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reviewer_note": {"type": "string", "minLength": 1}
      }
    },
    "practice_task": {
      "type": "object",
      "required": ["task_id", "prompt", "source_ids", "evidence_output_ids", "reviewer_note"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "prompt": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_output_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reviewer_note": {"type": "string", "minLength": 1}
      }
    },
    "evidence_checklist_item": {
      "type": "object",
      "required": ["evidence_id", "evidence_item", "source_ids", "reviewer_note"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "evidence_item": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reviewer_note": {"type": "string", "minLength": 1}
      }
    },
    "dossier_review_gate": {
      "type": "object",
      "required": ["gate_id", "status", "required_roles", "evidence_required_ids", "reviewer_note"],
      "additionalProperties": false,
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{2,120}$"},
        "status": {"enum": ["draft_only", "needs_human_review"]},
        "required_roles": {"type": "array", "minItems": 1, "items": {"enum": ["author", "editor", "teacher", "curriculum_reviewer", "legal_or_policy"]}},
        "evidence_required_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reviewer_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
